# all | api | worker — run the HTTP API and workers together, or split them into separate processes.
MODE=all
HOST=0.0.0.0
PORT=3100

REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=queue

# Queues and allowed task names are declared in src/catalog.ts.
WORKER_CONCURRENCY=5

# Comma separated bearer tokens (min 16 chars), one per client service (e.g. Core).
API_TOKENS=
# Shared with every webhook receiver; used to HMAC-sign outbound webhooks.
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_ATTEMPTS=8

DEFAULT_ATTEMPTS=3
DEFAULT_BACKOFF_MS=5000
KEEP_COMPLETED_SECONDS=86400
KEEP_FAILED_SECONDS=604800
